# Copy these settings into the backend env_file used by your environment.
# Never expose NIF_PT_API_KEY in React or commit its real value.
NIF_PT_API_KEY=

# Optional local Ollama. Empty MODEL disables AI; extraction still works.
CLIENT_ENRICHMENT_AI_MODEL=
CLIENT_ENRICHMENT_AI_URL=http://127.0.0.1:11434
# Docker Desktop with Ollama on the host: http://host.docker.internal:11434
